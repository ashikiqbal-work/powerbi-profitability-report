{
  "name": "Profitability",
  "compatibilityLevel": 1600,
  "model": {
    "culture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "expressions": [
      {
        "name": "SampleRows",
        "kind": "m",
        "expression": "Json.Document(Binary.Decompress(Binary.FromText(\"\", BinaryEncoding.Base64), Compression.Deflate))"
      }
    ],
    "tables": [
      {
        "name": "Sales",
        "columns": [
          {
            "name": "line_id",
            "dataType": "int64",
            "sourceColumn": "line_id",
            "summarizeBy": "none"
          },
          {
            "name": "order_id",
            "dataType": "int64",
            "sourceColumn": "order_id",
            "summarizeBy": "none"
          },
          {
            "name": "order_date",
            "dataType": "dateTime",
            "sourceColumn": "order_date",
            "summarizeBy": "none",
            "formatString": "yyyy-MM-dd"
          },
          {
            "name": "customer_id",
            "dataType": "int64",
            "sourceColumn": "customer_id",
            "summarizeBy": "none"
          },
          {
            "name": "product",
            "dataType": "string",
            "sourceColumn": "product",
            "summarizeBy": "none"
          },
          {
            "name": "channel",
            "dataType": "string",
            "sourceColumn": "channel",
            "summarizeBy": "none"
          },
          {
            "name": "quantity",
            "dataType": "int64",
            "sourceColumn": "quantity",
            "summarizeBy": "none"
          },
          {
            "name": "discount_pct",
            "dataType": "int64",
            "sourceColumn": "discount_pct",
            "summarizeBy": "none"
          },
          {
            "name": "returned",
            "dataType": "int64",
            "sourceColumn": "returned",
            "summarizeBy": "none"
          },
          {
            "name": "net_revenue_cents",
            "dataType": "int64",
            "sourceColumn": "net_revenue_cents",
            "summarizeBy": "none"
          },
          {
            "name": "profit_cents",
            "dataType": "int64",
            "sourceColumn": "profit_cents",
            "summarizeBy": "none"
          },
          {
            "name": "cogs_cents",
            "dataType": "int64",
            "sourceColumn": "cogs_cents",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Sales",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                " Source = Table.FromRecords(SampleRows),",
                " Selected = Table.SelectColumns(Source, {\"line_id\",\"order_id\",\"order_date\",\"customer_id\",\"product\",\"channel\",\"quantity\",\"discount_pct\",\"returned\",\"net_revenue_cents\",\"profit_cents\",\"cogs_cents\"}),",
                " Typed = Table.TransformColumnTypes(Selected, {{\"line_id\", Int64.Type},{\"order_id\", Int64.Type},{\"order_date\", type datetime},{\"customer_id\", Int64.Type},{\"product\", type text},{\"channel\", type text},{\"quantity\", Int64.Type},{\"discount_pct\", Int64.Type},{\"returned\", Int64.Type},{\"net_revenue_cents\", Int64.Type},{\"profit_cents\", Int64.Type},{\"cogs_cents\", Int64.Type}}, \"en-US\")",
                "in",
                " Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Net Revenue",
            "expression": "DIVIDE(SUM(Sales[net_revenue_cents]), 100)",
            "formatString": "$#,0.00"
          },
          {
            "name": "Gross Profit",
            "expression": "DIVIDE(SUM(Sales[profit_cents]), 100)",
            "formatString": "$#,0.00"
          },
          {
            "name": "Gross Margin",
            "expression": "DIVIDE([Gross Profit], [Net Revenue])",
            "formatString": "0.0%"
          },
          {
            "name": "Orders",
            "expression": "DISTINCTCOUNT(Sales[order_id])",
            "formatString": "#,0"
          },
          {
            "name": "Average Order Value",
            "expression": "DIVIDE([Net Revenue], [Orders])",
            "formatString": "$#,0.00"
          },
          {
            "name": "Return Line Rate",
            "expression": "DIVIDE(SUM(Sales[returned]), COUNTROWS(Sales))",
            "formatString": "0.0%"
          },
          {
            "name": "Revenue Previous Year",
            "expression": "CALCULATE([Net Revenue], DATEADD('Date'[Date], -1, YEAR))",
            "formatString": "$#,0.00"
          },
          {
            "name": "Revenue YoY",
            "expression": "DIVIDE([Net Revenue] - [Revenue Previous Year], [Revenue Previous Year])",
            "formatString": "0.0%"
          },
          {
            "name": "Loss Making Lines",
            "expression": "COUNTROWS(FILTER(Sales, Sales[profit_cents] < 0))",
            "formatString": "#,0"
          }
        ]
      },
      {
        "name": "Product",
        "columns": [
          {
            "name": "product",
            "dataType": "string",
            "sourceColumn": "product",
            "summarizeBy": "none"
          },
          {
            "name": "category",
            "dataType": "string",
            "sourceColumn": "category",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Product",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                " Source = Table.FromRecords(SampleRows),",
                " Selected = Table.SelectColumns(Source, {\"product\",\"category\"}),",
                " Typed = Table.TransformColumnTypes(Selected, {{\"product\", type text},{\"category\", type text}}, \"en-US\")",
                "in",
                " Table.Distinct(Typed)"
              ]
            }
          }
        ]
      },
      {
        "name": "Customer",
        "columns": [
          {
            "name": "customer_id",
            "dataType": "int64",
            "sourceColumn": "customer_id",
            "summarizeBy": "none"
          },
          {
            "name": "region",
            "dataType": "string",
            "sourceColumn": "region",
            "summarizeBy": "none"
          },
          {
            "name": "segment",
            "dataType": "string",
            "sourceColumn": "segment",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Customer",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                " Source = Table.FromRecords(SampleRows),",
                " Selected = Table.SelectColumns(Source, {\"customer_id\",\"region\",\"segment\"}),",
                " Typed = Table.TransformColumnTypes(Selected, {{\"customer_id\", Int64.Type},{\"region\", type text},{\"segment\", type text}}, \"en-US\")",
                "in",
                " Table.Distinct(Typed)"
              ]
            }
          }
        ]
      },
      {
        "name": "Date",
        "columns": [
          {
            "name": "Date",
            "dataType": "dateTime",
            "sourceColumn": "Date",
            "summarizeBy": "none",
            "formatString": "yyyy-MM-dd",
            "isKey": true
          },
          {
            "name": "Year",
            "dataType": "int64",
            "sourceColumn": "Year",
            "summarizeBy": "none"
          },
          {
            "name": "Month",
            "dataType": "string",
            "sourceColumn": "Month",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Date",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                " Source = Table.FromList(List.Dates(#date(2024,1,1),731,#duration(1,0,0,0)), Splitter.SplitByNothing(), {\"Date\"}),",
                " Typed = Table.TransformColumnTypes(Source, {{\"Date\", type datetime}}),",
                " Year = Table.AddColumn(Typed, \"Year\", each Date.Year([Date]), Int64.Type),",
                " Month = Table.AddColumn(Year, \"Month\", each Date.ToText(Date.From([Date]), \"yyyy-MM\"), type text)",
                "in",
                " Month"
              ]
            }
          }
        ]
      }
    ],
    "relationships": [
      {
        "name": "bab4af01-7b81-550d-b1cb-edfc22220c1e",
        "fromTable": "Sales",
        "fromColumn": "product",
        "toTable": "Product",
        "toColumn": "product",
        "crossFilteringBehavior": "oneDirection"
      },
      {
        "name": "a344e97a-4526-5156-965b-9aa609298b6f",
        "fromTable": "Sales",
        "fromColumn": "customer_id",
        "toTable": "Customer",
        "toColumn": "customer_id",
        "crossFilteringBehavior": "oneDirection"
      },
      {
        "name": "83005bd7-4e68-5780-ab76-6c8098fddeae",
        "fromTable": "Sales",
        "fromColumn": "order_date",
        "toTable": "Date",
        "toColumn": "Date",
        "crossFilteringBehavior": "oneDirection"
      }
    ]
  }
}